APP_NAME=AgriScan 3D API
APP_VERSION=1.0.0
DEBUG=False

# MongoDB Atlas connection string.
# Local example: mongodb://localhost:27017
# NEVER put real credentials in this file — real values live in .env only
# (which is not committed to Git).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=Agriscan3d
MONGODB_DB_NAME=agriscan_db

# JWT
# Generate a long random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# CORS - Netlify + Local
ALLOWED_ORIGINS=http://localhost:3000,https://agriscan-3d.netlify.app,https://agriscan-3d.vercel.app

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
